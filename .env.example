# PowerMind Configuration
APP_NAME=PowerMind
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Supported providers: mock, gemini, openai, groq, openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_REPAIR_ATTEMPTS=1

# Cache Configuration
CACHE_ENABLED=true
CACHE_MAX_SIZE=1024

# Solver Configuration
SOLVER_TIMEOUT_SECONDS=10.0
SOLVER_TOLERANCE=0.00001
